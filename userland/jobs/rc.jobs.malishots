# hakios-mali and the GPU's other users on the phone, with pictures (fbgrab -log NAME 300; tools/log/fbjpg.py LOG OUT.jpg
# NAME): mali-probe's stages first; Metal's own chain (metal_test); then, once the window server has settled, the screen
# as it is, the home screen after a swipe up, Control Center over it (its Liquid Glass is drawn by CoreAnimation's Metal
# renderer on the Mali), mali-probe's triangle sixteen times as big on the panel (--show), and gl_test's triangle
# through Mesa's panfrost. The pictures come last: the log keeps the console's last 256 KB. For the 27 release's small
# image: MALI27=$OBJ/mali RC_JOBS=userland/jobs/rc.jobs.malishots (darwin/mtk27.sh root), boot-args mali=1 metal=1.
/hakios/bin/mali-probe
/hakios/bin/tolog /hakios/bin/metal_test
/hakios/bin/rwtouch wait 280
/hakios/bin/fbgrab -log screen 300
/hakios/bin/rwtouch swipe 0.5 0.985 0.5 0.3 250 wait 8
/hakios/bin/fbgrab -log home 300
/hakios/bin/rwtouch swipe 0.92 0.003 0.92 0.5 300 wait 5
/hakios/bin/fbgrab -log glass 300
/hakios/bin/rwtouch button home wait 4
/hakios/bin/mali-probe --show 20 &
/hakios/bin/rwtouch wait 6
/hakios/bin/fbgrab -log triangle 300
/hakios/bin/rwtouch wait 16
/hakios/bin/gl_test 15 &
/hakios/bin/rwtouch wait 6
/hakios/bin/fbgrab -log gltest 300
/hakios/bin/rwtouch wait 120
