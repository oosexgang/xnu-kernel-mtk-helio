# The camera of the 27 release, read raw (XNU_DEFCONFIG=phone_camera: mtkcam=5, without CONNSYS): after the first
# unlock and back to the home screen, camera_test reads 30 frames from /dev/hakios-camera and says how many came, a
# kept line each (run 651: 30 frames of 30, 4080x3072).
/hakios/bin/rwtouch wait 160 swipe 0.705 0.586 0.707 0.587 150
/hakios/bin/rwtouch wait 30 swipe 0.5 0.95 0.5 0.3 300 wait 4 button home wait 4
/hakios/bin/tolog TOLOG_KEEP=1 /hakios/bin/camera_test raw 30
