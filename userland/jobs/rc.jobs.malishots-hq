# Two pictures in the quality the log can carry (fbgrab -log NAME 750 0.7: half the panel's width, ~70 KB each), taken
# in the run's last 40 s (mali-probe --until: seconds since boot) so that the log's last 256 KB still hold both: the home screen the Metal driver draws, and
# Control Center over it, whose Liquid Glass CoreAnimation draws with Metal on the Mali. mali-probe and metal_test run
# first. userland/jobs/rc.jobs.malishots-tri takes the triangles. For the 27
# release's small image: MALI27=$OBJ/mali RC_JOBS=userland/jobs/rc.jobs.malishots-hq, XNU_SECS=480, mali=1 metal=1.
/hakios/bin/mali-probe
/hakios/bin/tolog /hakios/bin/metal_test
/hakios/bin/mali-probe --until 425
/hakios/bin/rwtouch swipe 0.5 0.985 0.5 0.3 250 wait 8
/hakios/bin/fbgrab -log home 750 0.7
/hakios/bin/rwtouch swipe 0.92 0.003 0.92 0.5 300 wait 5
/hakios/bin/fbgrab -log glass 750 0.7
/hakios/bin/rwtouch wait 120
