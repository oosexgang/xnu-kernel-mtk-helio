# mali-probe's triangle sixteen times as big on the panel (--show: the GPU's own pixels, read back) and gl_test's
# triangle through Mesa's panfrost, each in the quality the log can carry (fbgrab -log NAME 750 0.7), taken in the run's
# last 40 s (mali-probe --until: seconds since boot). For the 27 release's small image: MALI27=$OBJ/mali RC_JOBS=userland/jobs/rc.jobs.malishots-tri, XNU_SECS=480,
# boot-args mali=1 metal=1.
/hakios/bin/mali-probe
/hakios/bin/mali-probe --until 420
/hakios/bin/mali-probe --show 20 &
/hakios/bin/rwtouch wait 6
/hakios/bin/fbgrab -log triangle 750 0.7
/hakios/bin/rwtouch wait 16
/hakios/bin/gl_test 15 &
/hakios/bin/rwtouch wait 6
/hakios/bin/fbgrab -log gltest 750 0.7
/hakios/bin/rwtouch wait 120
