# The home screen drawn by the native Mali library (boot-arg mali_native=1: userland/src/mali/rwa, no Gallium), and a
# picture of it at the panel's half width in the log (fbgrab -log NAME 750 0.7; tools/fbjpg.py LOG OUT.jpg home).
# Wallet's notification question at the 27 release's first boot: Allow, once, as a finger gives it (run 230's).
/hakios/bin/rwtouch wait 170 swipe 0.705 0.586 0.707 0.587 150
/hakios/bin/rwtouch wait 190
/hakios/bin/fbgrab -log home 750 0.7
/hakios/bin/rwtouch wait 150
